// check-g-parity.mjs — builds the real EventDag from
// test-vectors/g-scenario.json, materializes the full composed G, and
// prints a canonical JSON summary to stdout. Meant to be diffed against
// the Rust output of the same fixture
// (rust-core/examples/check_g_parity.rs) — see
// scripts/verify-g-parity.sh. This is Phase 5's cross-language parity
// check, extending the id-parity approach (Phase 0/§8.1) to the full
// composed economic view.
//
// Run: node scripts/check-g-parity.mjs

import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { EventDag } from '../public/js/core/event-dag.js';
import { materializeG } from '../public/js/core/economics/g.js';

const __dirname = dirname(fileURLToPath(import.meta.url));
const fixturePath = join(__dirname, '..', 'test-vectors', 'g-scenario.json');
const fixture = JSON.parse(readFileSync(fixturePath, 'utf8'));

const theta = { reward: { K: 1, alpha: 1, beta: 1 }, budgets: { d1: 100, d2: null } };

const dag = new EventDag();
const idByLabel = {};

for (const entry of fixture) {
  const parentIds = entry.parents.map((label) => idByLabel[label]);
  const id = await dag.addEvent(parentIds, entry.payload);
  idByLabel[entry.label] = id;
}

const state = materializeG(theta, dag.topoOrder());

function sortKeys(obj) {
  return Object.fromEntries(Object.entries(obj).sort(([a], [b]) => a.localeCompare(b)));
}

const summary = {
  cadenceDomains: sortKeys(
    Object.fromEntries(Object.entries(state.cadence.domains).map(([d, s]) => [d, s.epoch]))
  ),
  cadenceRejectionCount: state.cadence.rejections.length,
  scarcityDomains: sortKeys(
    Object.fromEntries(Object.entries(state.scarcity.domains).map(([d, s]) => [d, s.used]))
  ),
  balances: sortKeys(state.balances),
  accrualRejectionCount: state.accrualRejections.length,
};

console.log(JSON.stringify(summary, null, 2));
